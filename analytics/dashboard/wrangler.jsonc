{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbidkit-yibiao-analytics-dashboard",
  "compatibility_date": "2026-05-14",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
